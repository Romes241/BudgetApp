QMainWindow, QWidget {
    background-color: #111318;
    color: #f1f5f9;
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* Sidebar */
QFrame#sidebar {
    background-color: #191c23;
    border-right: 1px solid #30343d;
}

/* Labels */
QLabel#appTitle {
    background-color: transparent;
    font-size: 21px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#pageHeading {
    background-color: transparent;
    font-size: 27px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#sectionHeading {
    background-color: transparent;
    font-size: 17px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#secondaryText {
    background-color: transparent;
    color: #9ca3af;
}

QLabel#summaryTitle {
    background-color: transparent;
    color: #a1a1aa;
}

QLabel#summaryValue {
    background-color: transparent;
    font-size: 21px;
    font-weight: bold;
    color: #f1f5f9;
}

QLabel#errorText {
    background-color: transparent;
    color: #f87171;
}

/* Summary cards */
QFrame#summaryCard {
    background-color: #1b1e26;
    border: 1px solid #30343d;
    border-radius: 8px;
}

/* Global button styling */
QPushButton {
    background-color: #1b1e26;
    color: #e4e4e7;
    border: 1px solid #30343d;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #292333;
    border-color: #514366;
}

QPushButton:pressed {
    background-color: #352747;
}

QPushButton:disabled {
    background-color: #191c23;
    color: #62626b;
    border-color: #30343d;
}

/* Primary buttons */
QPushButton#primaryButton {
    background-color: #8b5cf6;
    color: white;
    border: 1px solid #8b5cf6;
    border-radius: 8px;
    padding: 9px 18px;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #7c3aed;
    border-color: #7c3aed;
}

QPushButton#primaryButton:disabled {
    background-color: #514366;
    color: #c4b5fd;
    border-color: #514366;
}

QPushButton#smallButton {
    padding: 6px 10px;
    font-size: 9pt;
}

/* Navigation buttons */
QPushButton#navigationButton {
    background-color: transparent;
    color: #cbd5e1;
    border: none;
    border-radius: 8px;
    padding: 11px 14px;
    text-align: left;
    font-size: 10pt;
}

QPushButton#navigationButton:hover {
    background-color: #292333;
    color: #ffffff;
}

QPushButton#navigationButton:checked {
    background-color: #352747;
    color: #c4a7ff;
    font-weight: bold;
}

/* Active / inactive filter buttons */
QPushButton#filterButton {
    background-color: transparent;
    color: #a1a1aa;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#filterButton:hover {
    background-color: #292333;
    color: #c4a7ff;
}

QPushButton#filterButton:checked {
    background-color: #352747;
    color: #c4a7ff;
}

/* Cashflow and expense tables */
QTableWidget#cashflowTable {
    background-color: #111318;
    alternate-background-color: #191c23;
    color: #f1f5f9;
    border: 1px solid #30343d;
    border-radius: 7px;
    gridline-color: #30343d;
    selection-background-color: #352747;
    selection-color: #ffffff;
}

QTableWidget#cashflowTable::item {
    padding: 7px;
}

/* Table headers */
QHeaderView::section {
    background-color: #20232b;
    color: #cbd5e1;
    border: none;
    border-right: 1px solid #30343d;
    border-bottom: 1px solid #30343d;
    padding: 9px 8px;
    font-weight: bold;
}

/* Status bar */
QStatusBar {
    background-color: #191c23;
    color: #9ca3af;
    border-top: 1px solid #30343d;
}

/* Form controls */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QDateEdit {
    background-color: #191c23;
    color: #f1f5f9;
    border: 1px solid #30343d;
    border-radius: 6px;
    padding: 7px 9px;
    selection-background-color: #352747;
    selection-color: #ffffff;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QDateEdit:focus {
    border-color: #8b5cf6;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #191c23;
    color: #f1f5f9;
    border: 1px solid #30343d;
    selection-background-color: #352747;
    selection-color: #ffffff;
    outline: none;
}

/* Checkbox indicators use a white checkmark when selected. */
QCheckBox {
    background-color: transparent;
    color: #e4e4e7;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #191c23;
    border: 1px solid #52525b;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #8b5cf6;
}

QCheckBox::indicator:checked {
    background-color: #8b5cf6;
    border-color: #8b5cf6;
    image: url(__CHECKBOX_CHECK_ICON__);
}

QCheckBox::indicator:disabled {
    background-color: #20232b;
    border-color: #3f3f46;
}

QScrollArea {
    background-color: transparent;
    border: none;
}